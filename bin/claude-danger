#!/bin/bash
set -euo pipefail

# claude-danger - Run Claude Code in an isolated container
# Usage: claude-danger <workspace-directory>

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

IMAGE_NAME="claude-danger"

usage() {
    echo "Usage: claude-danger <workspace-directory>"
    echo ""
    echo "Run Claude Code in an isolated Podman container with access"
    echo "only to the specified workspace directory."
    echo ""
    echo "Examples:"
    echo "  claude-danger ~/worktrees/myproject/claude-work"
    echo "  claude-danger ~/workspace/feature-name"
    exit 1
}

# Check argument
if [[ $# -lt 1 ]]; then
    usage
fi

WORKSPACE="$1"

# Resolve to absolute path
WORKSPACE=$(realpath "$WORKSPACE" 2>/dev/null || echo "$WORKSPACE")

# Create workspace if it doesn't exist
if [[ ! -d "$WORKSPACE" ]]; then
    echo -e "${YELLOW}Directory doesn't exist. Create it?${NC} $WORKSPACE"
    read -p "[y/N] " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        mkdir -p "$WORKSPACE"
        echo -e "${GREEN}Created:${NC} $WORKSPACE"
    else
        echo "Aborted."
        exit 1
    fi
fi

# Build image if it doesn't exist
if ! podman image exists "$IMAGE_NAME"; then
    echo -e "${CYAN}Building $IMAGE_NAME image (first run only)...${NC}"
    echo "This will take a few minutes."
    echo ""

    podman build -t "$IMAGE_NAME" -f - <<'DOCKERFILE'
FROM fedora:42

# Base dev tools
RUN dnf install -y \
    git git-lfs \
    nodejs npm \
    python3 python3-pip \
    golang \
    rustup \
    tmux htop vim \
    ripgrep fd-find bat fzf \
    jq yq \
    docker-cli \
    openssh-clients \
    keychain \
    gh \
    awscli2 \
    && dnf clean all

# PHP development tools
RUN dnf install -y \
    php php-cli php-devel php-common \
    php-mbstring php-xml php-pdo \
    php-mysqlnd php-pgsql \
    php-curl php-gd php-intl \
    php-bcmath php-zip php-opcache \
    php-sodium php-fpm \
    composer \
    && dnf clean all

# Azure CLI
RUN rpm --import https://packages.microsoft.com/keys/microsoft.asc \
    && dnf install -y https://packages.microsoft.com/config/rhel/9/packages-microsoft-prod.rpm 2>/dev/null || true \
    && dnf install -y azure-cli \
    && dnf clean all

# Google Cloud CLI
RUN cat > /etc/yum.repos.d/google-cloud-sdk.repo <<'GCLOUD_REPO'
[google-cloud-cli]
name=Google Cloud CLI
baseurl=https://packages.cloud.google.com/yum/repos/cloud-sdk-el9-x86_64
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://packages.cloud.google.com/yum/doc/rpm-package-key.gpg
GCLOUD_REPO
RUN dnf install -y google-cloud-cli && dnf clean all

# Claude Code
RUN npm install -g @anthropic-ai/claude-code

# Initialize rustup
RUN rustup-init -y

# Create home directory structure for rootless user (will be mapped via --userns=keep-id)
RUN mkdir -p /home/user/.claude && chown -R 1000:1000 /home/user

WORKDIR /workspace
DOCKERFILE

    echo ""
    echo -e "${GREEN}Image built successfully.${NC}"
fi

# Print warning banner
echo ""
echo -e "${RED}╔════════════════════════════════════════════════════════════╗${NC}"
echo -e "${RED}║${NC}  ${YELLOW}DANGER ZONE${NC} - Claude has access to:                       ${RED}║${NC}"
echo -e "${RED}║${NC}  ${CYAN}$WORKSPACE${NC}"
printf "${RED}║${NC}  %-58s ${RED}║${NC}\n" ""
echo -e "${RED}║${NC}  Claude can read, write, and delete files in this directory ${RED}║${NC}"
echo -e "${RED}║${NC}  Everything else on your system is ${GREEN}isolated${NC}                ${RED}║${NC}"
echo -e "${RED}╚════════════════════════════════════════════════════════════╝${NC}"
echo ""

# Copy credentials to persistent volume on first run
CLAUDE_VOLUME="claude-danger-config"
if ! podman volume exists "$CLAUDE_VOLUME"; then
    echo -e "${CYAN}Creating persistent config volume...${NC}"
    podman volume create "$CLAUDE_VOLUME"
    # Copy credentials into volume
    podman run --rm \
        -v "$CLAUDE_VOLUME":/config \
        -v "$HOME/.claude/.credentials.json:/src/credentials.json:ro,Z" \
        alpine sh -c "mkdir -p /config/.claude && cp /src/credentials.json /config/.claude/.credentials.json && chmod 600 /config/.claude/.credentials.json"
fi

# Run container - rootless with persistent config volume
exec podman run -it --rm \
    -v "$WORKSPACE":/workspace:Z \
    -v "$CLAUDE_VOLUME":/home/user:Z \
    -w /workspace \
    --userns=keep-id \
    --security-opt=no-new-privileges \
    --hostname=claude-sandbox \
    -e TERM="$TERM" \
    -e HOME="/home/user" \
    -e PATH="/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin" \
    "$IMAGE_NAME" \
    claude --dangerously-skip-permissions
[bazil@silverblue ~]$
