[Unit]
Description=Agentbox credential and egress broker
After=network-online.target nftables.service
Wants=network-online.target
Requires=nftables.service
ConditionPathExists=/etc/agentbox/broker.yaml
ConditionPathExists=!/etc/agentbox/STOP

[Service]
User=agentbox-broker
Group=agentbox
ExecStart=/opt/agentbox/bin/agentbox server broker
Restart=on-failure
RestartSec=5
RuntimeDirectory=agentbox-broker
RuntimeDirectoryMode=0750
StateDirectory=agentbox-broker
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
LimitCORE=0
MemoryMax=512M
MemorySwapMax=0
TasksMax=64
ReadWritePaths=/run/agentbox-broker /var/lib/agentbox-broker

[Install]
WantedBy=multi-user.target
